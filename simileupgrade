    // =========================================================================
    // GAME RUNTIME STATE
    // =========================================================================
    let activeDeck = [];
    let currentSceneIdx = 0;
    let currentStep = 1;
    let score = 0;
    let lives = 3;
    let secondsRemaining = 30;
    let timerHandle = null;

    function beginSession() {
      // Pick 10 random scenarios out of the 40-scenario master pool
      activeDeck = shuffle([...masterScenarios]).slice(0, 10);
      currentSceneIdx = 0;
      score = 0;

      document.getElementById("screen-start").style.display = "none";
      document.getElementById("screen-finish").style.display = "none";
      document.getElementById("screen-play").style.display = "flex";

      renderScene();
    }

    function returnToStart() {
      clearInterval(timerHandle);
      document.getElementById("screen-finish").style.display = "none";
      document.getElementById("screen-play").style.display = "none";
      document.getElementById("screen-start").style.display = "flex";
      document.getElementById("score-counter").textContent = "⭐ Stars: 0";
      document.getElementById("heart-meter").textContent = "❤️❤️❤️";
    }

    function renderScene() {
      clearInterval(timerHandle);
      const scene = activeDeck[currentSceneIdx];
      currentStep = 1;
      lives = 3;

      renderHeartsUI();
      document.getElementById("scene-counter-label").textContent = `Scene ${currentSceneIdx + 1} of 10`;
      document.getElementById("score-counter").textContent = `⭐ Stars: ${score}`;
      document.getElementById("btn-next-scene").style.display = "none";
      document.getElementById("polished-card").style.display = "none";
      document.getElementById("interactive-canvas").style.display = "flex";
      document.getElementById("instruction-hint").textContent = "Tap the weak words in the sentence to cross them out.";

      updateStepperUI();

      // Render Chunks
      const canvas = document.getElementById("interactive-canvas");
      canvas.innerHTML = "";
      scene.chunks.forEach((chunkText, idx) => {
        const chip = document.createElement("span");
        chip.className = "chunk-chip";
        chip.id = `chunk-${idx}`;
        chip.textContent = chunkText;
        chip.onclick = () => onChunkClick(idx);
        canvas.appendChild(chip);
      });

      document.getElementById("selection-shelf").innerHTML = "";

      // Launch 30s Countdown
      runTimer();
    }

    function renderHeartsUI() {
      let str = "";
      for (let i = 0; i < lives; i++) str += "❤️";
      for (let i = lives; i < 3; i++) str += "🖤";
      document.getElementById("heart-meter").textContent = str;
    }

    function penalizeMistake() {
      soundWrong();
      lives--;
      score = Math.max(0, score - 2);
      document.getElementById("score-counter").textContent = `⭐ Stars: ${score}`;
      renderHeartsUI();

      if (lives <= 0) {
        handleSceneFailure("Out of hearts! Review the model upgrade below.");
      }
    }

    function runTimer() {
      secondsRemaining = 30;
      updateTimerUI();

      timerHandle = setInterval(() => {
        secondsRemaining--;
        updateTimerUI();

        if (secondsRemaining <= 0) {
          clearInterval(timerHandle);
          handleSceneFailure("Time expired for this scene!");
        }
      }, 1000);
    }

    function updateTimerUI() {
      const bar = document.getElementById("timer-bar");
      const text = document.getElementById("timer-readout");
      const pct = (secondsRemaining / 30) * 100;
      bar.style.width = `${pct}%`;
      text.textContent = `${secondsRemaining}s`;

      if (secondsRemaining <= 8) {
        bar.style.backgroundColor = "var(--accent-red)";
      } else {
        bar.style.backgroundColor = "var(--accent-green)";
      }
    }

    function handleSceneFailure(message) {
      clearInterval(timerHandle);
      soundExpired();
      const scene = activeDeck[currentSceneIdx];

      document.getElementById("instruction-hint").textContent = message;
      document.getElementById("selection-shelf").innerHTML = "";

      // Reveal model upgrade sentence
      document.getElementById("interactive-canvas").style.display = "none";
      const banner = document.getElementById("polished-card");
      banner.innerHTML = `Model Upgrade:<br>"${scene.finalSentence}"`;
      banner.style.display = "block";

      setTimeout(() => {
        advanceNextScene();
      }, 3500);
    }

    function updateStepperUI() {
      for (let i = 1; i <= 3; i++) {
        const el = document.getElementById(`slot-${i}`);
        el.className = "stepper-pill";
        if (i < currentStep) el.classList.add("completed");
        else if (i === currentStep) el.classList.add("active");
      }
    }

    function onChunkClick(idx) {
      if (currentStep !== 1 || secondsRemaining <= 0 || lives <= 0) return;
      const scene = activeDeck[currentSceneIdx];
      const clicked = document.getElementById(`chunk-${idx}`);

      if (idx === scene.targetIdx) {
        soundStrike();
        clicked.classList.add("struck");
        score += 10;
        document.getElementById("score-counter").textContent = `⭐ Stars: ${score}`;
        setTimeout(initStep2, 350);
      } else {
        clicked.classList.add("wrong-tap");
        penalizeMistake();
        setTimeout(() => clicked.classList.remove("wrong-tap"), 350);
      }
    }

    function initStep2() {
      if (lives <= 0) return;
      currentStep = 2;
      updateStepperUI();
      const scene = activeDeck[currentSceneIdx];

      document.getElementById("instruction-hint").textContent = "Select the best power verb:";

      const shelf = document.getElementById("selection-shelf");
      shelf.className = "shelf-grid verb-grid-4";

      const verbs = shuffle(scene.verbOptions);
      renderButtons(verbs, (verb, btn) => {
        if (verb === scene.powerVerb) {
          soundCorrect();
          score += 15;
          document.getElementById("score-counter").textContent = `⭐ Stars: ${score}`;

          const target = document.getElementById(`chunk-${scene.targetIdx}`);
          target.textContent = verb;
          target.className = "chunk-chip power-slotted";

          setTimeout(initStep3, 350);
        } else {
          btn.classList.add("wrong-tap");
          penalizeMistake();
          setTimeout(() => btn.classList.remove("wrong-tap"), 350);
        }
      });
    }

    function initStep3() {
      if (lives <= 0) return;
      currentStep = 3;
      updateStepperUI();
      const scene = activeDeck[currentSceneIdx];

      document.getElementById("instruction-hint").textContent = "Match the simile that fits the scene's mood:";

      const shelf = document.getElementById("selection-shelf");
      shelf.className = "shelf-grid simile-grid-5";

      const similes = shuffle(scene.simileOptions);
      renderButtons(similes, (chosenSimile, btn) => {
        if (chosenSimile === scene.simile) {
          clearInterval(timerHandle);
          soundFanfare();

          const speedBonus = Math.floor(secondsRemaining / 5);
          score += 20 + speedBonus;
          document.getElementById("score-counter").textContent = `⭐ Stars: ${score}`;

          // Transition to full grammatical sentence
          document.getElementById("interactive-canvas").style.display = "none";
          const banner = document.getElementById("polished-card");
          banner.innerHTML = `Upgraded Script (+${speedBonus} Speed Bonus):<br>"${scene.finalSentence}"`;
          banner.style.display = "block";

          document.getElementById("selection-shelf").innerHTML = "";
          document.getElementById("instruction-hint").textContent = "Scene complete! Ready for next scene.";
          document.getElementById("btn-next-scene").style.display = "inline-block";
        } else {
          btn.classList.add("wrong-tap");
          penalizeMistake();
          setTimeout(() => btn.classList.remove("wrong-tap"), 350);
        }
      });
    }

    function renderButtons(list, onSelect) {
      const shelf = document.getElementById("selection-shelf");
      shelf.innerHTML = "";
      list.forEach(val => {
        const b = document.createElement("button");
        b.className = "choice-card-btn";
        b.textContent = val;
        b.onclick = () => onSelect(val, b);
        shelf.appendChild(b);
      });
    }

    function advanceNextScene() {
      clearInterval(timerHandle);
      currentSceneIdx++;
      if (currentSceneIdx < 10) {
        renderScene();
      } else {
        document.getElementById("screen-play").style.display = "none";
        document.getElementById("screen-finish").style.display = "flex";
        document.getElementById("finish-summary-line").textContent = 
          `All 10 scenes completed. Total score: ${score} Stars.`;
      }
    }

    function shuffle(arr) {
      return [...arr].sort(() => Math.random() - 0.5);
    }
