<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Script Doctor: The Simile Upgrade</title>
  <style>
    :root {
      --bg-canvas: #090d16;
      --panel-surface: #131b2e;
      --panel-elevated: #1e293b;
      --border-subtle: #2d3b55;
      --border-focus: #475569;
      --text-heading: #f8fafc;
      --text-body: #cbd5e1;
      --text-muted: #94a3b8;
      
      --accent-primary: #38bdf8;
      --accent-gold: #f59e0b;
      --accent-gold-bg: rgba(245, 158, 11, 0.12);
      --accent-green: #10b981;
      --accent-green-bg: #064e3b;
      --accent-red: #ef4444;
      --accent-red-bg: rgba(239, 68, 68, 0.18);

      --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
      user-select: none;
      -webkit-user-select: none;
    }

    body {
      margin: 0;
      padding: clamp(10px, 2.5vw, 24px);
      font-family: var(--font-stack);
      background-color: var(--bg-canvas);
      color: var(--text-body);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      line-height: 1.5;
    }

    /* Top Studio Header */
    header {
      width: 100%;
      max-width: 860px;
      background: var(--panel-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 12px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    }

    .brand-title {
      font-size: clamp(0.95rem, 2.2vw, 1.15rem);
      font-weight: 700;
      color: var(--text-heading);
      letter-spacing: 0.3px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .stats-tray {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .heart-meter {
      font-size: 1.1rem;
      letter-spacing: 2px;
    }

    .score-chip {
      background: #090d16;
      border: 1px solid var(--border-subtle);
      color: var(--accent-gold);
      padding: 6px 14px;
      border-radius: 8px;
      font-weight: 700;
      font-size: clamp(0.85rem, 2vw, 0.95rem);
      letter-spacing: 0.5px;
    }

    /* Main Console Surface */
    .studio-console {
      width: 100%;
      max-width: 860px;
      background: var(--panel-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 18px;
      padding: clamp(16px, 3vw, 26px);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    /* Start / Instructions Screen */
    .splash-view {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 12px 6px;
      gap: 18px;
    }

    .splash-view h2 {
      font-size: clamp(1.4rem, 4vw, 1.9rem);
      font-weight: 800;
      color: var(--text-heading);
      margin: 0;
      letter-spacing: -0.5px;
    }

    .splash-subtitle {
      font-size: clamp(0.9rem, 2vw, 1.05rem);
      color: var(--text-muted);
      max-width: 580px;
      margin: -6px 0 4px 0;
    }

    .instruction-flow {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 14px;
      width: 100%;
      max-width: 780px;
      margin-top: 4px;
    }

    .step-card {
      background: #090d16;
      border: 1px solid var(--border-subtle);
      border-radius: 12px;
      padding: 16px 14px;
      text-align: left;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .step-tag {
      font-size: 0.8rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--accent-primary);
    }

    .step-title {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text-heading);
      margin: 0;
    }

    .step-desc {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.4;
      margin: 0;
    }

    .badge-summary {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      font-size: 0.88rem;
      color: #94a3b8;
    }

    .badge-summary span {
      background: #090d16;
      border: 1px solid var(--border-subtle);
      padding: 5px 12px;
      border-radius: 6px;
    }

    .btn-action-primary {
      background: var(--accent-primary);
      color: #090d16;
      border: none;
      padding: 14px 44px;
      font-size: 1.1rem;
      font-weight: 800;
      border-radius: 10px;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(56, 189, 248, 0.25);
      transition: background 0.15s ease, transform 0.15s ease;
    }

    .btn-action-primary:active {
      transform: scale(0.97);
    }

    /* Gameplay Metadata & Countdown Bar */
    .game-meta-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }

    .scene-counter-badge {
      background: #090d16;
      border: 1px solid var(--border-subtle);
      padding: 6px 12px;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.88rem;
      color: var(--accent-primary);
      letter-spacing: 0.5px;
      white-space: nowrap;
    }

    .timer-track-wrap {
      flex: 1;
      display: flex;
      align-items: center;
      gap: 10px;
      background: #090d16;
      padding: 6px 12px;
      border-radius: 10px;
      border: 1px solid var(--border-subtle);
    }

    .timer-meter {
      flex: 1;
      height: 7px;
      background: #1e293b;
      border-radius: 4px;
      overflow: hidden;
    }

    .timer-meter-fill {
      width: 100%;
      height: 100%;
      background: var(--accent-green);
      transition: width 1s linear, background-color 0.3s ease;
    }

    .timer-digital {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text-heading);
      min-width: 30px;
      text-align: right;
    }

    /* Workflow Stepper */
    .workflow-stepper {
      display: flex;
      gap: 8px;
    }

    .stepper-pill {
      flex: 1;
      padding: 8px 6px;
      border-radius: 8px;
      text-align: center;
      font-size: clamp(0.75rem, 1.8vw, 0.85rem);
      font-weight: 700;
      background: #090d16;
      color: var(--text-muted);
      border: 1px solid var(--border-subtle);
      transition: border-color 0.2s, color 0.2s, background-color 0.2s;
    }

    .stepper-pill.active {
      background: var(--panel-elevated);
      color: var(--accent-gold);
      border-color: var(--accent-gold);
    }

    .stepper-pill.completed {
      background: var(--accent-green-bg);
      color: #a7f3d0;
      border-color: var(--accent-green);
    }

    /* Canvas / Screen */
    .editor-canvas {
      background: #090d16;
      border: 1px dashed var(--border-focus);
      border-radius: 12px;
      padding: 20px 16px;
      min-height: 120px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 10px;
      font-size: clamp(1.1rem, 2.5vw, 1.25rem);
      line-height: 1.6;
    }

    .chunk-chip {
      display: inline-block;
      padding: 8px 14px;
      border-radius: 9px;
      background: var(--panel-surface);
      color: var(--text-heading);
      border: 1px solid var(--border-subtle);
      cursor: pointer;
      font-weight: 600;
      transition: transform 0.12s ease, border-color 0.12s ease;
    }

    .chunk-chip:active {
      transform: scale(0.97);
    }

    .chunk-chip.struck {
      text-decoration: line-through 3px var(--accent-red);
      background: var(--accent-red-bg);
      color: #fca5a5;
      border-color: var(--accent-red);
    }

    .chunk-chip.power-slotted {
      background: var(--accent-gold-bg);
      color: var(--accent-gold);
      border-color: var(--accent-gold);
      font-weight: 800;
    }

    /* Completed Polished Banner */
    .polished-banner {
      background: #064e3b;
      border: 1px solid var(--accent-green);
      border-radius: 12px;
      padding: 16px 20px;
      font-size: clamp(1.1rem, 2.4vw, 1.25rem);
      line-height: 1.6;
      font-weight: 700;
      color: #f0fdf4;
      text-align: center;
      display: none;
    }

    /* Dynamic Shelf Grids */
    .shelf-grid {
      display: grid;
      gap: 10px;
      min-height: 75px;
    }

    .verb-grid-4 {
      grid-template-columns: repeat(4, 1fr);
    }

    .simile-grid-5 {
      grid-template-columns: repeat(5, 1fr);
    }

    .choice-card-btn {
      background: #090d16;
      color: var(--text-heading);
      border: 1px solid var(--border-subtle);
      border-radius: 9px;
      padding: 12px 8px;
      font-size: clamp(0.85rem, 1.8vw, 0.95rem);
      font-weight: 600;
      text-align: center;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s, border-color 0.15s;
    }

    .choice-card-btn:active {
      background: var(--panel-elevated);
    }

    .choice-card-btn.wrong-tap {
      background: var(--accent-red-bg) !important;
      border-color: var(--accent-red) !important;
      animation: shake 0.35s ease;
    }

    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-5px); }
      75% { transform: translateX(5px); }
    }

    /* Footer Navigation */
    .footer-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      min-height: 44px;
      gap: 10px;
    }

    .hint-label {
      font-size: 0.9rem;
      color: var(--text-muted);
      font-weight: 600;
    }

    .btn-advance {
      background: var(--accent-primary);
      color: #090d16;
      border: none;
      padding: 10px 22px;
      font-size: 0.95rem;
      font-weight: 800;
      border-radius: 8px;
      cursor: pointer;
      display: none;
      white-space: nowrap;
    }

    /* Responsive Breakpoints (Tablets, Phones, Small Laptops) */
    @media (max-width: 768px) {
      .verb-grid-4 { grid-template-columns: repeat(2, 1fr); }
      .simile-grid-5 { grid-template-columns: repeat(2, 1fr); }
      .simile-grid-5 .choice-card-btn:last-child { grid-column: span 2; }
    }

    @media (max-width: 480px) {
      body { padding: 8px; }
      .studio-console { padding: 14px; gap: 12px; }
      .stepper-pill { font-size: 0.72rem; padding: 6px 3px; }
    }
  </style>
</head>
<body>

  <!-- Top Studio Navigation -->
  <header>
    <div class="brand-title">
      <span>🖋️</span>
      <span>Script Doctor: Simile Upgrade</span>
    </div>
    <div class="stats-tray">
      <span class="heart-meter" id="heart-meter">❤️❤️❤️</span>
      <span class="score-chip" id="score-counter">⭐ Stars: 0</span>
    </div>
  </header>

  <!-- Main Interaction Console -->
  <div class="studio-console">

    <!-- Screen 1: Dedicated Startup Page -->
    <div class="splash-view" id="screen-start">
      <h2>Transform Dull Drafts to Cinema</h2>
      <p class="splash-subtitle">
        Review the three-step editing method below. Your 30-second timer begins only after you press Start.
      </p>

      <div class="instruction-flow">
        <div class="step-card">
          <span class="step-tag">Step 01</span>
          <h3 class="step-title">Cut Weak Words</h3>
          <p class="step-desc">Tap the weak verb phrase or boring modifier to cross it out of the script.</p>
        </div>
        <div class="step-card">
          <span class="step-tag">Step 02</span>
          <h3 class="step-title">Slot Power Verb</h3>
          <p class="step-desc">Choose the vivid action verb from 4 distinct options to replace the weak phrase.</p>
        </div>
        <div class="step-card">
          <span class="step-tag">Step 03</span>
          <h3 class="step-title">Bridge Simile</h3>
          <p class="step-desc">Select the comparison from 5 options that best reflects the scene's mood.</p>
        </div>
      </div>

      <div class="badge-summary">
        <span>⏱️ 30s per scene</span>
        <span>❤️ 3 Hearts per question</span>
        <span>🎲 10 randomized scenes</span>
        <span>⭐ Speed bonuses included</span>
      </div>

      <button class="btn-action-primary" onclick="beginSession()">Start Session ➡</button>
    </div>

    <!-- Screen 2: Interactive Game Screen -->
    <div id="screen-play" style="display: none; flex-direction: column; gap: 14px;">
      
      <!-- Metadata Row: Progress, Hearts & Timer -->
      <div class="game-meta-row">
        <span class="scene-counter-badge" id="scene-counter-label">Scene 1 of 10</span>
        <div class="timer-track-wrap">
          <div class="timer-meter">
            <div class="timer-meter-fill" id="timer-bar"></div>
          </div>
          <span class="timer-digital" id="timer-readout">30s</span>
        </div>
      </div>

      <!-- Step Progress Indicators -->
      <div class="workflow-stepper">
        <div class="stepper-pill active" id="slot-1">1. Strike Weak Words</div>
        <div class="stepper-pill" id="slot-2">2. Power Verb</div>
        <div class="stepper-pill" id="slot-3">3. Match Simile</div>
      </div>

      <!-- Working Interactive Screen -->
      <div class="editor-canvas" id="interactive-canvas"></div>

      <!-- Final Master Script Card -->
      <div class="polished-banner" id="polished-card"></div>

      <!-- Selection Tray -->
      <div class="shelf-grid" id="selection-shelf"></div>

      <!-- Control Strip -->
      <div class="footer-bar">
        <span class="hint-label" id="instruction-hint">Tap the weak words in the sentence to cross them out.</span>
        <button class="btn-advance" id="btn-next-scene" onclick="advanceNextScene()">Next Scene ➡</button>
      </div>
    </div>

    <!-- Screen 3: End of Session Summary -->
    <div class="splash-view" id="screen-finish" style="display: none;">
      <h2>Session Complete</h2>
      <p class="splash-subtitle" id="finish-summary-line">All 10 scenes completed.</p>
      <div style="font-size: 2.8rem; margin: 6px 0;">⭐ 📋 🎬</div>
      <button class="btn-action-primary" onclick="returnToStart()">Restart New Session 🔄</button>
    </div>

  </div>

  <script>
    // Universal Web Audio Synthesizer (Works on iOS, Android, macOS, Windows, ChromeOS)
    let audioCtx = null;
    function getAudioContext() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
      return audioCtx;
    }

    function triggerAudio(freq, type = 'sine', duration = 0.12) {
      try {
        const ctx = getAudioContext();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, ctx.currentTime);
        gain.gain.setValueAtTime(0.12, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + duration);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + duration);
      } catch (e) {}
    }

    function soundStrike() { triggerAudio(260, 'triangle', 0.15); }
    function soundCorrect() {
      triggerAudio(523.25, 'sine', 0.1);
      setTimeout(() => triggerAudio(659.25, 'sine', 0.15), 90);
    }
    function soundFanfare() {
      [523.25, 659.25, 783.99, 1046.50].forEach((f, i) => {
        setTimeout(() => triggerAudio(f, 'triangle', 0.18), i * 90);
      });
    }
    function soundWrong() { triggerAudio(180, 'sawtooth', 0.2); }
    function soundExpired() { triggerAudio(140, 'sawtooth', 0.45); }

    // =========================================================================
    // 40 COMPREHENSIVE SCENARIOS (Includes 10 Easier, Child-Friendly Additions)
